# Copy to .env. Never commit real credentials, secret keys, or mailbox passwords.
# Production MAILPILOT_SECRET_KEY must be a stable random value of at least 32 bytes.
MAILPILOT_ENV=development
MAILPILOT_SECRET_KEY=
DATABASE_URL=sqlite:///mailpilot.sqlite
FLASK_DEBUG=false
MAX_UPLOAD_SIZE_BYTES=5242880
# Leave at zero unless an explicitly trusted reverse proxy overwrites X-Forwarded-For/Proto.
MAILPILOT_TRUSTED_PROXY_HOPS=0

# Enable Secure cookies only when served over HTTPS.
MAILPILOT_SECURE_COOKIES=false
MAILPILOT_AUTH_IDLE_TIMEOUT_MINUTES=30

# Gmail SMTP: STARTTLS on port 587. Use a Google app password when required.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_TIMEOUT=20
MAILPILOT_DAILY_RECIPIENT_LIMIT=100

# Required for campaign unsubscribe links. Use an HTTPS origin you control.
MAILPILOT_PUBLIC_BASE_URL=

# Optional inbound DSN mailbox for matched bounce processing over IMAP SSL.
# Leave username/password blank to keep bounce polling disabled.
MAIL_IMAP_SERVER=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_IMAP_USERNAME=
MAIL_IMAP_PASSWORD=
MAIL_IMAP_FOLDER=INBOX
MAIL_IMAP_POLL_SECONDS=60
